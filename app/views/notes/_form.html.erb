<%= form_with model: note do |form| %>
  <% if note.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(note.errors.count, "error") %> stopped this note from saving:</h2>
      <ul>
        <% note.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :body %>
    <%= form.text_area :body, rows: 8 %>
  </div>

  <div class="actions">
    <%= form.submit "Save Note", class: "button" %>
  </div>
<% end %>
